<Window x:Class="PocketBridge.App.AdbConsoleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization" Title="{loc:Loc AdbConsole}" Width="900" Height="620" MinWidth="700" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
 <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{loc:Loc AdbConsole}" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="TargetText" Margin="0,4,0,12" Foreground="{StaticResource WarningBrush}"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CommandBox" Style="{StaticResource TextField}" FontFamily="Consolas" KeyDown="CommandBox_KeyDown"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{loc:Loc RunCommand}" Click="Run_Click" Margin="8,0,0,0"/></Grid><TextBox x:Name="OutputBox" Grid.Row="2" Margin="0,12" Background="#070A10" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Grid Grid.Row="3"><CheckBox x:Name="TimestampBox" Content="{loc:Loc AddTimestamps}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource BaseButton}" Content="{loc:Loc CancelCommand}" Click="Cancel_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc Clear}" Click="Clear_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc CopyOutput}" Click="Copy_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc Close}" IsCancel="True"/></StackPanel></Grid></Grid></Border>
</Window>
