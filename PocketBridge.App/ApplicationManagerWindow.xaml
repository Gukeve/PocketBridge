<Window x:Class="PocketBridge.App.ApplicationManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization"
        Title="{loc:Loc Applications}" Width="940" Height="690" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="ApplicationTemplate"><Border Margin="0,0,0,8" Padding="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="8" Background="#222B3D"><TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHoverBrush}" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock Text="{Binding PackageName}" Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding VersionLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="{Binding TypeLabel}" HorizontalAlignment="Right" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" /></StackPanel></Grid></Border></DataTemplate>
    </Window.Resources>
    <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="{loc:Loc Applications}" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="DeviceText" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="250" Style="{StaticResource TextField}" TextChanged="Search_TextChanged" ToolTip="{loc:Loc SearchApplications}" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc Refresh}" Margin="8,0,0,0" Click="Refresh_Click" /></StackPanel></Grid>
            <TabControl x:Name="TypeTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="TypeTabs_SelectionChanged">
                <TabItem Header="{loc:Loc UserApplications}"><ListBox x:Name="UserList" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ApplicationTemplate}" /></TabItem>
                <TabItem Header="{loc:Loc SystemApplications}"><ListBox x:Name="SystemList" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ApplicationTemplate}" /></TabItem>
            </TabControl>
            <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc LaunchApplication}" Click="Launch_Click" Margin="0,0,8,8" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc StopApplication}" Click="Stop_Click" Margin="0,0,8,8" /><Button Style="{StaticResource DangerButton}" Content="{loc:Loc UninstallApplication}" Click="Uninstall_Click" Margin="0,0,8,8" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc UpdateApplication}" Click="Update_Click" Margin="0,0,8,8" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc CopyPackageName}" Click="CopyPackage_Click" Margin="0,0,8,8" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc OpenApplicationDetails}" Click="Details_Click" Margin="0,0,8,8" /><Button Style="{StaticResource DangerButton}" Content="{loc:Loc ClearApplicationData}" Click="ClearData_Click" Margin="0,0,8,8" /></WrapPanel>
            <Grid Grid.Row="4" Margin="0,8,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource BaseButton}" Click="Close_Click" Content="{loc:Loc Close}" /></Grid>
        </Grid>
    </Border>
</Window>
