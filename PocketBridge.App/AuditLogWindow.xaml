<Window x:Class="PocketBridge.App.AuditLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Audit log" Width="900" Height="620" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
 <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Audit log" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Bounded local history. Tokens, contents and full serials are never recorded." Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,14,0,10"><TextBox x:Name="ActorFilter" Width="180" Style="{StaticResource TextField}" ToolTip="Actor" TextChanged="Filter_Changed" Margin="0,0,8,0"/><TextBox x:Name="DeviceFilter" Width="180" Style="{StaticResource TextField}" ToolTip="Device alias" TextChanged="Filter_Changed" Margin="0,0,8,0"/><ComboBox x:Name="ResultFilter" Width="180" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All results" IsSelected="True"/><ComboBoxItem Content="Success"/><ComboBoxItem Content="Denied"/><ComboBoxItem Content="Failed"/></ComboBox></WrapPanel>
  <DataGrid x:Name="RecordsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=g}"/><DataGridTextColumn Header="Actor" Binding="{Binding Actor}"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceAlias}"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="180"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource DangerButton}" Content="Clear" Click="Clear_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="Close" IsCancel="True"/></StackPanel>
 </Grid></Border>
</Window>
