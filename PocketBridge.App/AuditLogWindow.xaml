<Window x:Class="PocketBridge.App.AuditLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization" Title="{loc:Loc P3_AuditLog}" Width="980" Height="650" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{loc:Loc P3_AuditLog}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc P3_AuditHelp}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,14,0,10"><TextBox x:Name="ActorFilter" Width="145" Style="{StaticResource TextField}" ToolTip="{loc:Loc P3_Actor}" TextChanged="Filter_Changed" Margin="0,0,8,0"/><TextBox x:Name="DeviceFilter" Width="145" Style="{StaticResource TextField}" ToolTip="{loc:Loc P3_DeviceAlias}" TextChanged="Filter_Changed" Margin="0,0,8,0"/><TextBox x:Name="CategoryFilter" Width="125" Style="{StaticResource TextField}" ToolTip="{loc:Loc P3_Category}" TextChanged="Filter_Changed" Margin="0,0,8,0"/><ComboBox x:Name="SeverityFilter" Width="115" SelectionChanged="Filter_Changed" Margin="0,0,8,0"><ComboBoxItem Content="{loc:Loc P3_AllSeverity}" IsSelected="True"/><ComboBoxItem Content="{loc:Loc P3_Info}"/><ComboBoxItem Content="{loc:Loc P3_Warning}"/><ComboBoxItem Content="{loc:Loc P3_Error}"/></ComboBox><ComboBox x:Name="ResultFilter" Width="125" SelectionChanged="Filter_Changed" Margin="0,0,8,0"><ComboBoxItem Content="{loc:Loc P3_AllResults}" IsSelected="True"/><ComboBoxItem Content="{loc:Loc P3_Success}"/><ComboBoxItem Content="{loc:Loc P3_Accepted}"/><ComboBoxItem Content="{loc:Loc P3_Denied}"/><ComboBoxItem Content="{loc:Loc P3_Failed}"/></ComboBox><DatePicker x:Name="FromDate" Width="130" SelectedDateChanged="Filter_Changed" ToolTip="{loc:Loc P3_FromDate}"/></WrapPanel>
  <DataGrid x:Name="RecordsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc P3_Time}" Binding="{Binding Timestamp, StringFormat=g}"/><DataGridTextColumn Header="{loc:Loc P3_Actor}" Binding="{Binding Actor}"/><DataGridTextColumn Header="{loc:Loc P3_DeviceAlias}" Binding="{Binding DeviceAlias}"/><DataGridTextColumn Header="{loc:Loc P3_Category}" Binding="{Binding Category}"/><DataGridTextColumn Header="{loc:Loc P3_Severity}" Binding="{Binding Severity}"/><DataGridTextColumn Header="{loc:Loc P3_Action}" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="{loc:Loc P3_Outcome}" Binding="{Binding Result}" Width="180"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_ExportRedacted}" Click="Export_Click" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="{loc:Loc Clear}" Click="Clear_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc Close}" IsCancel="True"/></StackPanel>
 </Grid></Border>
</Window>
