<UserControl x:Class="PocketBridge.App.Controls.AndroidDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Background="#05070B"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseMove="OnMouseMove" MouseWheel="OnMouseWheel"
             MouseRightButtonDown="OnMouseRightButtonDown"
             KeyDown="OnKeyDown" KeyUp="OnKeyUp" TextInput="OnTextInput">
    <Grid ClipToBounds="True">
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
        <Canvas x:Name="MappingOverlay" Background="#22000000" Visibility="Collapsed" MouseLeftButtonDown="OnOverlayClick" Panel.ZIndex="5" />
        <Border x:Name="EditorToolbar" Panel.ZIndex="7" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8" Padding="7" CornerRadius="9" Background="#EE111827" BorderBrush="#526A9E" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="EditToolBox" Width="130" SelectionChanged="EditTool_Changed" ToolTip="Control type" />
                <Button Content="Undo" Click="Undo_Click" Margin="6,0,0,0" MinWidth="52" />
                <Button Content="Redo" Click="Redo_Click" Margin="4,0,0,0" MinWidth="52" />
                <Button Content="Duplicate" Click="Duplicate_Click" Margin="4,0,0,0" MinWidth="68" />
                <Button Content="Delete" Click="Delete_Click" Margin="4,0,0,0" MinWidth="58" />
                <CheckBox x:Name="SnapBox" Content="Snap" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border x:Name="MetricsOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                Padding="7,5" CornerRadius="5" Background="#CC080B12" BorderBrush="#526A9E" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="MetricsText" FontFamily="Consolas" FontSize="10" Foreground="#DDE7FF" />
        </Border>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#65718A" HorizontalAlignment="Center" />
            <TextBlock Text="Подключите устройство для встроенного просмотра" Margin="0,10,0,0" Foreground="#8E9AB0" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
