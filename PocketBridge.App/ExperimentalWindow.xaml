<Window x:Class="PocketBridge.App.ExperimentalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PocketBridge P3" Width="900" Height="700" MinWidth="740" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="P3 capabilities" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DeviceText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
  <TabControl Grid.Row="2">
   <TabItem Header="Input / OTG"><StackPanel Margin="14"><TextBlock x:Name="InputStatus" TextWrapping="Wrap"/><TextBlock x:Name="GamepadStatus" Margin="0,12,0,0"/><TextBlock Text="OTG is an exclusive USB control mode. Embedded mirroring is unavailable while OTG owns the device." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button x:Name="OtgButton" Style="{StaticResource BaseButton}" Content="Start OTG control mode" Click="Otg_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></TabItem>
   <TabItem Header="Displays"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="DisplayStatus" TextWrapping="Wrap"/><TreeView x:Name="DisplaysList" Grid.Row="1" Margin="0,12,0,0" DisplayMemberPath="Name"/><WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Style="{StaticResource BaseButton}" Content="Open selected display embedded" Click="DisplayOpen_Click" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="Stop selected display" Click="DisplayStop_Click" Margin="0,0,8,8"/><Button x:Name="Create720Button" Style="{StaticResource BaseButton}" Content="Create Android virtual display 1280×720" Click="Create720_Click" Margin="0,0,8,8"/><Button x:Name="Create1080Button" Style="{StaticResource BaseButton}" Content="Create Android virtual display 1920×1080" Click="Create1080_Click"/></WrapPanel></Grid></TabItem>
   <TabItem Header="LAN"><StackPanel Margin="14"><TextBlock Text="LAN is off by default. ViewScreen is the default permission. Control requires explicit opt-in and every message is authenticated, Origin-checked, permission-checked and replay-protected." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="Private bind address" Margin="0,12,0,5"/><TextBox x:Name="BindBox" Text="127.0.0.1" Style="{StaticResource TextField}"/><CheckBox x:Name="AllowControlBox" Content="Allow touch, keyboard and device buttons for this session" Margin="0,12,0,0"/><WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Enable LAN session" Click="LanStart_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="Disable and revoke" Click="LanStop_Click"/></WrapPanel><TextBlock x:Name="LanStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></TabItem>
   <TabItem Header="Automation"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RulesGrid" AutoGenerateColumns="True" IsReadOnly="True"/><WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Style="{StaticResource BaseButton}" Content="Audit log" Click="Audit_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="Add safe screenshot rule" Click="AddRule_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="Duplicate" Click="DuplicateRule_Click" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteRule_Click"/></WrapPanel></Grid></TabItem>
  </TabControl>
  <Button Grid.Row="3" Style="{StaticResource BaseButton}" IsCancel="True" Content="Close" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid></Border>
</Window>
