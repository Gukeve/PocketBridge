<Window x:Class="PocketBridge.App.ExperimentalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization" Title="PocketBridge P3" Width="900" Height="700" MinWidth="740" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{loc:Loc P3_Title}" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DeviceText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
  <TabControl Grid.Row="2">
   <TabItem Header="{loc:Loc P3_InputOtg}"><StackPanel Margin="14"><TextBlock x:Name="InputStatus" TextWrapping="Wrap"/><TextBlock x:Name="GamepadStatus" Margin="0,12,0,0"/><TextBlock Text="{loc:Loc P3_OtgWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button x:Name="OtgButton" Style="{StaticResource BaseButton}" Content="{loc:Loc P3_StartOtg}" Click="Otg_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></TabItem>
   <TabItem Header="{loc:Loc P3_Displays}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="DisplayStatus" TextWrapping="Wrap"/><TreeView x:Name="DisplaysList" Grid.Row="1" Margin="0,12,0,0"><TreeViewItem x:Name="DeviceDisplayRoot" IsExpanded="True"/></TreeView><WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc P3_OpenEmbedded}" Click="DisplayOpen_Click" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_OpenExternal}" Click="DisplayExternal_Click" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_StopSelected}" Click="DisplayStop_Click" Margin="0,0,8,8"/><TextBox x:Name="DisplayPackageBox" Width="220" Style="{StaticResource TextField}" ToolTip="{loc:Loc P3_PackageTooltip}" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_LaunchOnDisplay}" Click="DisplayLaunchApp_Click" Margin="0,0,8,8"/></WrapPanel><Border Grid.Row="3" Padding="10" Margin="0,8,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{loc:Loc P3_VirtualExperimental}" Foreground="{StaticResource WarningBrush}"/><WrapPanel Margin="0,8,0,0"><Button x:Name="Create720Button" Style="{StaticResource BaseButton}" Content="{loc:Loc P3_Create720}" Click="Create720_Click" Margin="0,0,8,0"/><Button x:Name="Create1080Button" Style="{StaticResource BaseButton}" Content="{loc:Loc P3_Create1080}" Click="Create1080_Click" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="{loc:Loc P3_RemoveVirtual}" Click="VirtualStop_Click"/></WrapPanel></StackPanel></Border></Grid></TabItem>
   <TabItem Header="{loc:Loc P3_Lan}"><StackPanel Margin="14"><TextBlock Text="{loc:Loc P3_LanWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="{loc:Loc P3_PrivateBind}" Margin="0,12,0,5"/><TextBox x:Name="BindBox" Text="127.0.0.1" Style="{StaticResource TextField}"/><CheckBox x:Name="AllowControlBox" Content="{loc:Loc P3_AllowControl}" Margin="0,12,0,0"/><WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc P3_EnableLan}" Click="LanStart_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_DisableRevoke}" Click="LanStop_Click"/></WrapPanel><TextBlock x:Name="LanStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></TabItem>
   <TabItem Header="{loc:Loc P3_Automation}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RulesGrid" AutoGenerateColumns="True" IsReadOnly="True"/><WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_AuditLog}" Click="Audit_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_AddScreenshotRule}" Click="AddRule_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="{loc:Loc P3_Duplicate}" Click="DuplicateRule_Click" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="{loc:Loc P3_Delete}" Click="DeleteRule_Click"/></WrapPanel></Grid></TabItem>
  </TabControl><Button Grid.Row="3" Style="{StaticResource BaseButton}" IsCancel="True" Content="{loc:Loc Close}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid></Border>
</Window>
