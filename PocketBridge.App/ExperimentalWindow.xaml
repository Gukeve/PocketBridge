<Window x:Class="PocketBridge.App.ExperimentalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PocketBridge Experimental" Width="860" Height="700" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner"><Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Experimental capabilities" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DeviceText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><TabControl Grid.Row="2"><TabItem Header="Input / OTG"><StackPanel Margin="14"><TextBlock x:Name="InputStatus" TextWrapping="Wrap"/><TextBlock x:Name="GamepadStatus" Margin="0,12,0,0"/><TextBlock Text="OTG is a separate exclusive USB control mode. Mirroring is unavailable while OTG owns the device." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button x:Name="OtgButton" Style="{StaticResource BaseButton}" Content="Start OTG control mode" Click="Otg_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></TabItem><TabItem Header="Displays"><StackPanel Margin="14"><TextBlock x:Name="DisplayStatus" TextWrapping="Wrap"/><ListBox x:Name="DisplaysList" Margin="0,12,0,0" DisplayMemberPath="Name"/><WrapPanel Margin="0,12,0,0"><Button x:Name="Create720Button" Style="{StaticResource BaseButton}" Content="Create 1280×720 / 240 DPI" Click="Create720_Click" Margin="0,0,8,0"/><Button x:Name="Create1080Button" Style="{StaticResource BaseButton}" Content="Create 1920×1080 / 320 DPI" Click="Create1080_Click"/></WrapPanel></StackPanel></TabItem><TabItem Header="LAN"><StackPanel Margin="14"><TextBlock Text="LAN access is OFF by default. A token is generated for a time-limited view-only browser session." TextWrapping="Wrap"/><TextBlock Text="Bind address" Margin="0,12,0,5"/><TextBox x:Name="BindBox" Text="127.0.0.1" Style="{StaticResource TextField}"/><WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Enable view-only LAN" Click="LanStart_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="Disable and revoke" Click="LanStop_Click"/></WrapPanel><TextBlock x:Name="LanStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></TabItem><TabItem Header="Automation"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RulesGrid" AutoGenerateColumns="True" IsReadOnly="True"/><WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Style="{StaticResource BaseButton}" Content="Add safe screenshot rule" Click="AddRule_Click" Margin="0,0,8,0"/><Button Style="{StaticResource BaseButton}" Content="Duplicate" Click="DuplicateRule_Click" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteRule_Click"/></WrapPanel></Grid></TabItem></TabControl><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource BaseButton}" IsCancel="True" Content="Close"/></StackPanel></Grid></Border></Window>
