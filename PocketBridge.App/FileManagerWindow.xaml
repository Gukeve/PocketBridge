<Window x:Class="PocketBridge.App.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PocketBridge.App.Localization"
        Title="{loc:Loc Files}" Width="820" Height="610" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Files}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="{loc:Loc Refresh}" Click="Refresh_Click" />
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,16,0,10">
                <Button Style="{StaticResource BaseButton}" Content="{loc:Loc GoUp}" Margin="0,0,8,8" Click="Up_Click" />
                <Button Style="{StaticResource BaseButton}" Content="Download" Tag="Download" Margin="0,0,8,8" Click="QuickFolder_Click" />
                <Button Style="{StaticResource BaseButton}" Content="DCIM" Tag="DCIM" Margin="0,0,8,8" Click="QuickFolder_Click" />
                <Button Style="{StaticResource BaseButton}" Content="Pictures" Tag="Pictures" Margin="0,0,8,8" Click="QuickFolder_Click" />
                <Button Style="{StaticResource BaseButton}" Content="Movies" Tag="Movies" Margin="0,0,8,8" Click="QuickFolder_Click" />
                <Button Style="{StaticResource BaseButton}" Content="Music" Tag="Music" Margin="0,0,8,8" Click="QuickFolder_Click" />
                <Button Style="{StaticResource BaseButton}" Content="Documents" Tag="Documents" Margin="0,0,8,8" Click="QuickFolder_Click" />
            </WrapPanel>

            <Border Grid.Row="2" Margin="0,0,0,10" Padding="12,8" CornerRadius="9" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc CurrentPath}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="PathText" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="3" x:Name="EntriesList" Background="{StaticResource WindowBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     MouseDoubleClick="Entries_DoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CardHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#293957" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Entry.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <WrapPanel Grid.Column="1">
                    <Button Style="{StaticResource BaseButton}" Content="{loc:Loc UploadFile}" Margin="8,0,0,0" Click="Upload_Click" />
                    <Button Style="{StaticResource BaseButton}" Content="{loc:Loc DownloadFile}" Margin="8,0,0,0" Click="Download_Click" />
                    <Button Style="{StaticResource BaseButton}" Content="{loc:Loc NewFolder}" Margin="8,0,0,0" Click="NewFolder_Click" />
                    <Button Style="{StaticResource BaseButton}" Content="{loc:Loc Rename}" Margin="8,0,0,0" Click="Rename_Click" />
                    <Button Style="{StaticResource DangerButton}" Content="{loc:Loc Delete}" Margin="8,0,0,0" Click="Delete_Click" />
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
