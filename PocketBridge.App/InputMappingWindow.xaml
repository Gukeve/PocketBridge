<Window x:Class="PocketBridge.App.InputMappingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PocketBridge.App" Title="Input Mapping" Width="900" Height="650" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Input Mapping" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Normalized touch, keyboard, mouse and gamepad profiles" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="ProfilesBox" Width="260" HorizontalAlignment="Right" SelectionChanged="Profile_Changed" DisplayMemberPath="Name"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Profile name"/><TextBox x:Name="NameBox" Style="{StaticResource TextField}" Margin="0,6,0,12"/><TextBlock Text="Target alias (kept local)"/><TextBox x:Name="TargetBox" Style="{StaticResource TextField}" Margin="0,6,0,12"/><WrapPanel><Button Style="{StaticResource BaseButton}" Content="New" Click="New_Click" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="Duplicate" Click="Duplicate_Click" Margin="0,0,8,8"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="Delete_Click" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="Import" Click="Import_Click" Margin="0,0,8,8"/><Button Style="{StaticResource BaseButton}" Content="Export" Click="Export_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="Touch coordinates use 0.0–1.0 and remain stable across resize, DPI and orientation." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/></StackPanel>
   <DataGrid x:Name="BindingsGrid" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="True" Background="{StaticResource CardBrush}"><DataGrid.Columns><DataGridComboBoxColumn Header="Source" SelectedItemBinding="{Binding SourceKind}" ItemsSource="{Binding Source={x:Static local:InputMappingWindow.SourceKinds}}"/><DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="*"/><DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding ActionKind}" ItemsSource="{Binding Source={x:Static local:InputMappingWindow.ActionKinds}}"/><DataGridTextColumn Header="Value / keycode" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="X" Binding="{Binding X}"/><DataGridTextColumn Header="Y" Binding="{Binding Y}"/><DataGridTextColumn Header="Dead zone" Binding="{Binding DeadZone}"/></DataGrid.Columns></DataGrid>
  </Grid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource BaseButton}" IsCancel="True" Content="Close" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Content="Save profile" Click="Save_Click"/></StackPanel>
 </Grid></Border>
</Window>
