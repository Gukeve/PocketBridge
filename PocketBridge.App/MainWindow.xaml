<Window x:Class="PocketBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PocketBridge.App.Localization"
        xmlns:controls="clr-namespace:PocketBridge.App.Controls"
        Title="PocketBridge" Width="1180" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        AllowDrop="True" Drop="Window_Drop">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ConnectCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="24,16,24,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Loc AppName}" FontSize="24" FontWeight="SemiBold" /><Border Margin="12,2,0,2" Padding="9,3" CornerRadius="9" Background="#172137"><TextBlock Text="MVP" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" FontWeight="SemiBold" /></Border></StackPanel>
                    <TextBlock Text="{loc:Loc Subtitle}" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource TopBarChip}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding AdbStatusBrush}" /><TextBlock Text="{Binding AdbStatusText}" VerticalAlignment="Center" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource TopBarChip}" MinWidth="104" Margin="0,0,10,0"><TextBlock Text="{Binding DeviceCountText}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" /></Border>
                    <Button Height="46" VerticalAlignment="Center" Style="{StaticResource BaseButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" ToolTip="{loc:Loc RefreshTooltip}" AutomationProperties.Name="{loc:Loc Refresh}"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontSize="19" Margin="0,-2,8,0" /><TextBlock Text="{loc:Loc Refresh}" /></StackPanel></Button>
                    <Button Height="46" VerticalAlignment="Center" Style="{StaticResource BaseButton}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="{loc:Loc Settings}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc Settings}" /></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,8,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="6,4,6,14"><TextBlock Text="{loc:Loc Devices}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc SelectPhone}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /></Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemChrome" CornerRadius="12" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#1B2538" /><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#3B4964" /></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#293957" /><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#526A9E" /></Trigger>
                                                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="ItemChrome" Property="Background" Value="#304362" /><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></MultiTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /><Setter TargetName="ItemChrome" Property="BorderThickness" Value="2" /></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemChrome" Property="Opacity" Value="0.58" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Background="Transparent" CornerRadius="12" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="48" CornerRadius="7" BorderBrush="{StaticResource TextMutedBrush}" BorderThickness="2" VerticalAlignment="Top"><Ellipse Width="4" Height="4" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,4,0,0" /></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Serial}" Margin="0,3,0,8" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal"><Border Padding="7,2" CornerRadius="7" Background="#222B3D" Margin="0,0,7,0"><TextBlock Text="{Binding ConnectionLabel}" FontSize="11" /></Border><Border Padding="7,2" CornerRadius="7" Background="#222B3D"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="11" FontWeight="SemiBold" /></Border></StackPanel>
                                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" FontSize="11" Visibility="{Binding IsSessionRunning, Converter={StaticResource BooleanToVisibilityConverter}}"><Run Text="● " /><Run Text="{loc:Loc SessionActive}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="62" Height="62" CornerRadius="31" Background="#182033" HorizontalAlignment="Center"><TextBlock Text="＋" FontSize="30" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="{loc:Loc ConnectDevicePrompt}" Margin="0,16,0,6" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="{loc:Loc EnableUsbDebugging}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowSelectionPrompt, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{loc:Loc ChooseDevice}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{loc:Loc NoAutomaticLaunch}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" /></StackPanel>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding SelectedDevice.FriendlyName}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedDevice.ModelLine}" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedDevice.Serial}" Margin="0,14,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" /></StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding SelectedDevice.StateLabel}" Foreground="{Binding SelectedDevice.StateBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{Binding SelectedDevice.ConnectionLabel}" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" /></StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Content="{loc:Loc Connect}" />
                            <Button Grid.Column="2" Style="{StaticResource BaseButton}" Command="{Binding StopCommand}" Content="{loc:Loc Stop}" />
                            <Button Grid.Column="4" Style="{StaticResource BaseButton}" Command="{Binding RestartCommand}" Content="{loc:Loc RestartSession}" />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc DeviceControls}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc SerialSafety}" FontSize="11" Margin="0,3,0,7" Foreground="{StaticResource TextSecondaryBrush}" />
                                <UniformGrid Columns="3" Rows="2">
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="8,4" FontSize="11" Margin="0,0,8,6" Command="{Binding BackCommand}" Content="{loc:Loc Back}" /><Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="8,4" FontSize="11" Margin="0,0,8,6" Command="{Binding HomeCommand}" Content="{loc:Loc Home}" /><Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="8,4" FontSize="11" Margin="0,0,0,6" Command="{Binding RecentsCommand}" Content="{loc:Loc Recents}" />
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="8,4" FontSize="11" Margin="0,0,8,0" Command="{Binding VolumeUpCommand}" Content="{loc:Loc VolumeUp}" /><Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="8,4" FontSize="11" Margin="0,0,8,0" Command="{Binding VolumeDownCommand}" Content="{loc:Loc VolumeDown}" /><Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="8,4" FontSize="11" Command="{Binding PowerCommand}" Content="{loc:Loc Power}" />
                                </UniformGrid>
                                <Separator Margin="0,8,0,7" Background="{StaticResource BorderBrush}" />
                                <TextBlock Text="{loc:Loc Actions}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <UniformGrid Columns="6" Rows="1">
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="4" FontFamily="Segoe Fluent Icons" FontSize="15" Command="{Binding OpenFilesCommand}" Content="&#xE8B7;" ToolTip="{loc:Loc Files}" AutomationProperties.Name="{loc:Loc Files}" Margin="0,0,5,0" />
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="4" FontFamily="Segoe Fluent Icons" FontSize="15" Command="{Binding InstallApkCommand}" Content="&#xE898;" ToolTip="{loc:Loc InstallApk}" AutomationProperties.Name="{loc:Loc InstallApk}" Margin="0,0,5,0" />
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="4" FontFamily="Segoe Fluent Icons" FontSize="15" Command="{Binding WifiCommand}" Content="&#xE701;" ToolTip="{loc:Loc Wifi}" AutomationProperties.Name="{loc:Loc Wifi}" Margin="0,0,5,0" />
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="4" FontFamily="Segoe Fluent Icons" FontSize="15" Command="{Binding ScreenshotCommand}" Content="&#xE722;" ToolTip="{loc:Loc Screenshot}" AutomationProperties.Name="{loc:Loc Screenshot}" Margin="0,0,5,0" />
                                    <Button Style="{StaticResource DangerButton}" MinHeight="34" Padding="4" FontFamily="Segoe Fluent Icons" FontSize="15" Command="{Binding RebootCommand}" Content="&#xE777;" ToolTip="{loc:Loc RestartAndroid}" AutomationProperties.Name="{loc:Loc RestartAndroid}" Margin="0,0,5,0" />
                                    <Button Style="{StaticResource BaseButton}" MinHeight="34" Padding="4" FontFamily="Segoe Fluent Icons" FontSize="15" Command="{Binding OpenExternalCommand}" Content="&#xE8A7;" ToolTip="{loc:Loc OpenExternal}" AutomationProperties.Name="{loc:Loc OpenExternal}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                            <Border Grid.Column="2" Background="#0C111B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{loc:Loc EmbeddedPreview}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="scrcpy-server 4.1 · H.264 · встроенный режим" Margin="0,5,0,8" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Margin="0,0,0,8" CornerRadius="10" BorderBrush="#3A465F" BorderThickness="1" Background="#05070B" ClipToBounds="True">
                                        <controls:AndroidDisplayControl Session="{Binding SelectedEmbeddedSession}" />
                                    </Border>
                                    <Button Grid.Row="2" Style="{StaticResource BaseButton}" Command="{Binding OpenExternalCommand}" Content="{loc:Loc OpenExternal}" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Visibility="{Binding ShowToolsMissingState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#18233A" HorizontalAlignment="Center"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="{loc:Loc NeedRuntimeTitle}" Margin="0,18,0,7" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="{loc:Loc NeedRuntimeBody}" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrepareToolsCommand}" Content="{loc:Loc DownloadAutomatically}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource BaseButton}" Command="{Binding OpenSettingsCommand}" Content="{loc:Loc Details}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="24,0,24,14" Background="#0D111A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ProgressBar Width="80" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Margin="12,0" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding SessionSummary}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
