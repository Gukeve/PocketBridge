<Window x:Class="PocketBridge.App.MediaResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization" Title="{loc:Loc MediaSaved}" Width="620" Height="230" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"><StackPanel><TextBlock Text="{loc:Loc MediaSaved}" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="PathText" Margin="0,10,0,18" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" /><WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc Open}" Click="Open_Click" Margin="0,0,8,0" /><Button x:Name="CopyButton" Style="{StaticResource BaseButton}" Content="{loc:Loc Copy}" Click="Copy_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc ShowInExplorer}" Click="Explorer_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc Close}" IsCancel="True" /></WrapPanel></StackPanel></Border>
</Window>
