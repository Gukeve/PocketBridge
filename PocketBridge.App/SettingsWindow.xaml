<Window x:Class="PocketBridge.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization"
        Title="{loc:Loc Settings}" Width="720" Height="720" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Border Margin="20" Padding="24" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{loc:Loc Settings}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc InterfaceLanguage}" Margin="0,24,0,7" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguageBox" MinHeight="42" Padding="10,6" Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}" SelectionChanged="LanguageBox_SelectionChanged" />
                    <TextBlock x:Name="LanguageRestartText" Text="{loc:Loc LanguageRestart}" Margin="0,7,0,0" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed" />

                    <Separator Margin="0,24,0,20" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:Loc ToolsFolder}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc ManagedRuntimeHelp}" Margin="0,7,0,16" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="ToolsDirectoryBox" Style="{StaticResource TextField}" IsReadOnly="True" TextChanged="ToolsDirectoryBox_TextChanged" />
                    <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="AdbStatusText" /><TextBlock x:Name="ScrcpyStatusText" Grid.Column="1" /><TextBlock x:Name="ServerStatusText" Grid.Column="2" /></Grid>
                    </Border>
                    <TextBlock x:Name="ValidationText" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" />

                    <Separator Margin="0,24,0,20" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:Loc MediaSettings}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc RecordingFolder}" Margin="0,14,0,7" FontWeight="SemiBold" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="RecordingFolderBox" Style="{StaticResource TextField}" /><Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="{loc:Loc Browse}" Click="BrowseRecording_Click" Margin="8,0,0,0" /></Grid>
                    <TextBlock Text="{loc:Loc RecordingFormat}" Margin="0,12,0,7" FontWeight="SemiBold" /><ComboBox x:Name="RecordingFormatBox" MinHeight="40" Background="{StaticResource WindowBrush}"><ComboBoxItem Content="MP4" Tag="mp4" /><ComboBoxItem Content="MKV" Tag="mkv" /></ComboBox>
                    <TextBlock Text="{loc:Loc RecordingVideoCodec}" Margin="0,12,0,7" FontWeight="SemiBold" /><ComboBox x:Name="RecordingCodecBox" MinHeight="40" Background="{StaticResource WindowBrush}" />
                    <CheckBox x:Name="RecordingAudioBox" Margin="0,12,0,0" Content="{loc:Loc RecordingAudioTrack}" />
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Resolution}" /><TextBox x:Name="RecordingSizeBox" Style="{StaticResource TextField}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FPS" /><TextBox x:Name="RecordingFpsBox" Style="{StaticResource TextField}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="{loc:Loc Bitrate}" /><TextBox x:Name="RecordingBitrateBox" Style="{StaticResource TextField}" /></StackPanel></Grid>
                    <TextBlock Text="{loc:Loc ScreenshotFolder}" Margin="0,14,0,7" FontWeight="SemiBold" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ScreenshotFolderBox" Style="{StaticResource TextField}" /><Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="{loc:Loc Browse}" Click="BrowseScreenshot_Click" Margin="8,0,0,0" /></Grid>
                    <TextBlock Text="{loc:Loc FilenameFormat}" Margin="0,12,0,7" FontWeight="SemiBold" /><TextBox x:Name="ScreenshotFormatBox" Style="{StaticResource TextField}" />

                    <Separator Margin="0,24,0,20" Background="{StaticResource BorderBrush}" />
                    <Grid><TextBlock Text="{loc:Loc Shortcuts}" FontSize="20" FontWeight="SemiBold" /><Button HorizontalAlignment="Right" Style="{StaticResource BaseButton}" Content="{loc:Loc ResetDefaults}" Click="ResetShortcuts_Click" /></Grid>
                    <TextBlock Text="{loc:Loc ShortcutsHelp}" Margin="0,7,0,12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <DataGrid x:Name="ShortcutGrid" ItemsSource="{Binding ShortcutItems}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="260" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc ShortcutAction}" Binding="{Binding Action}" IsReadOnly="True" Width="*" /><DataGridTextColumn Header="{loc:Loc ShortcutScope}" Binding="{Binding Scope}" IsReadOnly="True" Width="*" /><DataGridTextColumn Header="{loc:Loc ShortcutGesture}" Binding="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}" Width="*" /></DataGrid.Columns>
                    </DataGrid>

                    <Separator Margin="0,24,0,20" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:Loc About}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="PocketBridge" Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{loc:Loc AboutIndependent}" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{loc:Loc NotOfficial}" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="{loc:Loc ScrcpyCopyright}" Margin="0,14,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource BaseButton}" Content="{loc:Loc OpenScrcpyProject}" Click="OpenScrcpy_Click" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BaseButton}" Content="{loc:Loc OpenApacheLicense}" Click="OpenLicense_Click" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BaseButton}" Content="{loc:Loc ThirdParty}" Click="OpenThirdParty_Click" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BaseButton}" Content="{loc:Loc CheckUpdates}" Click="CheckUpdates_Click" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BaseButton}" Content="{loc:Loc GithubPocketBridge}" IsEnabled="False" ToolTip="{loc:Loc RepositoryNotPublished}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Style="{StaticResource BaseButton}" IsCancel="True" Content="{loc:Loc Cancel}" Margin="0,0,10,0" /><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="Save_Click" Content="{loc:Loc Save}" /></StackPanel>
        </Grid>
    </Border>
</Window>
