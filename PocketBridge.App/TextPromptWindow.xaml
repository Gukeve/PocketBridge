<Window x:Class="PocketBridge.App.TextPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization" Width="440" Height="240" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Margin="20" Padding="22" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Name="PromptText" FontSize="18" FontWeight="SemiBold" /><TextBox Grid.Row="1" x:Name="ValueBox" Style="{StaticResource TextField}" Margin="0,14,0,0" /><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource BaseButton}" IsCancel="True" Content="{loc:Loc Cancel}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" IsDefault="True" Content="{loc:Loc Save}" Click="Accept_Click" /></StackPanel></Grid></Border>
</Window>
