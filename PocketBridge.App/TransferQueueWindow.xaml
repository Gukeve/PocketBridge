<Window x:Class="PocketBridge.App.TransferQueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization"
        Title="{loc:Loc Transfers}" Width="920" Height="620" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Window.Resources><DataTemplate x:Key="TransferRow"><Border Margin="0,0,0,9" Padding="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TargetLine}" Margin="0,4,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DetailsLine}" Margin="0,0,0,7" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /><ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" /><TextBlock Text="{Binding Error}" Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" FontSize="11" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border Padding="8,3" CornerRadius="7" Background="#222B3D"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="11" FontWeight="SemiBold" /></Border><TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel></Grid></Border></DataTemplate></Window.Resources>
    <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="{loc:Loc Transfers}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc TransferQueueHelp}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="DiagnosticText" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><ComboBox x:Name="StatusFilterBox" Width="150" MinHeight="40" SelectionChanged="StatusFilter_Changed" /><TextBox x:Name="FilterBox" Width="240" Margin="8,0,0,0" Style="{StaticResource TextField}" TextChanged="Filter_TextChanged" ToolTip="{loc:Loc Filter}" /></StackPanel></Grid>
            <TabControl x:Name="TransferTabs" Grid.Row="2" SelectionChanged="TransferTabs_SelectionChanged"><TabItem Header="{loc:Loc Active}"><ListBox x:Name="ActiveList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource TransferRow}" /></TabItem><TabItem Header="{loc:Loc History}"><ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource TransferRow}" /></TabItem></TabControl>
            <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource BaseButton}" Content="{loc:Loc CancelTransfer}" Click="Cancel_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc RetryTransfer}" Click="Retry_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc RevealInExplorer}" Click="Reveal_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc CopyDestination}" Click="CopyDestination_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc ClearHistory}" Click="ClearHistory_Click" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" Click="Close_Click" Content="{loc:Loc Close}" /></WrapPanel>
        </Grid>
    </Border>
</Window>
