<Window x:Class="PocketBridge.App.TransferQueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PocketBridge.App.Localization"
        Title="{loc:Loc Transfers}" Width="840" Height="560" MinWidth="720" MinHeight="440" WindowStartupLocation="CenterOwner">
    <Border Margin="20" Padding="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="{loc:Loc Transfers}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc TransferQueueHelp}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource BaseButton}" Content="{loc:Loc ClearCompleted}" Click="ClearCompleted_Click" /></Grid>
            <ListBox x:Name="TransfersList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,9" Padding="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TargetLine}" Margin="0,4,0,7" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /><ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" /><TextBlock Text="{Binding Error}" Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" FontSize="11" /></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border Padding="8,3" CornerRadius="7" Background="#222B3D"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="11" FontWeight="SemiBold" /></Border><TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                    </Grid>
                </Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource BaseButton}" Content="{loc:Loc CancelTransfer}" Click="Cancel_Click" Margin="0,0,8,0" /><Button Style="{StaticResource BaseButton}" Content="{loc:Loc RetryTransfer}" Click="Retry_Click" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" IsCancel="True" Content="{loc:Loc Close}" /></StackPanel>
        </Grid>
    </Border>
</Window>
